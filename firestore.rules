rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ======================================================
    // GLOBAL DEFAULT DENY
    // ======================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ======================================================
    // HELPERS
    // ======================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
             (
               request.auth.uid == 'KISSD7wLdDg69pIwwhOHRjE8jng2' ||
               request.auth.uid == 'qDk00X1eexUq8oLEI2Pq6sX4Qp63' ||
               (request.auth.token != null && request.auth.token.email == 'mutohar.fauzi@gmail.com') ||
               (request.auth.token != null && request.auth.token.email == 'kepegawaian@untidar.ac.id')
             );
    }

    function isValidId(id) {
      return id is string &&
             id.size() <= 128 &&
             id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isTimestamp(value) {
      return value is timestamp;
    }

    // ======================================================
    // VALIDATORS
    // ======================================================

    function isValidSiteSettings(data) {
      return data.keys().hasAll([
        'header',
        'hero',
        'footer',
        'updatedAt'
      ]) &&

      data.header is map &&
      data.hero is map &&
      data.footer is map &&

      (
        !data.keys().hasAny(['announcements']) ||
        data.announcements is list
      ) &&

      (
        !data.keys().hasAny(['recentDocuments']) ||
        data.recentDocuments is list
      ) &&

      (
        !data.keys().hasAny(['applications']) ||
        data.applications is list
      ) &&

      (
        !data.keys().hasAny(['services']) ||
        data.services is list
      ) &&

      (
        !data.keys().hasAny(['profile']) ||
        data.profile is map
      ) &&

      (
        !data.keys().hasAny(['skmSettings']) ||
        data.skmSettings is map
      ) &&

      (
        !data.keys().hasAny(['bantuan']) ||
        data.bantuan is map
      ) &&

      isTimestamp(data.updatedAt);
    }

    function isValidAnnouncement(data) {
      return data.keys().hasAll([
        'title',
        'date',
        'tag',
        'createdAt',
        'updatedAt'
      ]) &&

      data.title is string &&
      data.title.size() <= 200 &&

      data.date is string &&
      data.date.size() <= 50 &&

      data.tag is string &&
      data.tag.size() <= 50 &&

      isTimestamp(data.createdAt) &&
      isTimestamp(data.updatedAt);
    }

    function isValidDocument(data) {
      return data.keys().hasAll([
        'title',
        'type',
        'date',
        'createdAt',
        'updatedAt'
      ]) &&

      data.title is string &&
      data.title.size() <= 300 &&

      data.type is string &&
      data.type.size() <= 100 &&

      data.date is string &&
      data.date.size() <= 50 &&

      isTimestamp(data.createdAt) &&
      isTimestamp(data.updatedAt);
    }

    function isValidApplication(data) {
      return data.keys().hasAll([
        'title',
        'desc',
        'icon',
        'color',
        'url',
        'createdAt',
        'updatedAt'
      ]) &&

      data.title is string &&
      data.title.size() <= 100 &&

      data.desc is string &&
      data.desc.size() <= 300 &&

      data.icon is string &&
      data.icon.size() <= 50 &&

      data.color is string &&
      data.color.size() <= 50 &&

      data.url is string &&
      data.url.size() <= 500 &&

      isTimestamp(data.createdAt) &&
      isTimestamp(data.updatedAt);
    }

    function isValidAdminConfig(data) {
      return data.keys().hasAll([
        'emails',
        'updatedAt'
      ]) &&

      data.emails is list &&
      data.emails.size() <= 100 &&

      (
        data.emails.size() == 0 ||
        data.emails[0] is string
      ) &&

      isTimestamp(data.updatedAt);
    }

    function isValidServiceDetail(data) {
      return data.title is string &&
             data.description is string &&
             data.dasarHukum is list &&
             data.pengertian is string &&
             data.alurSteps is list &&
             data.pic is string &&
             (!data.keys().hasAny(['jenisKenaikanPangkat']) || data.jenisKenaikanPangkat is list) &&
             (!data.keys().hasAny(['sopMode']) || data.sopMode is string) &&
             (!data.keys().hasAny(['sopUrl']) || data.sopUrl is string) &&
             data.updatedAt != null;
    }

    // ======================================================
    // SITE SETTINGS
    // ======================================================

    match /site_settings/main {

      allow read: if true;

      allow create, update:
      if isAdmin();

      allow delete:
      if isAdmin();
    }

    // ======================================================
    // ANNOUNCEMENTS
    // ======================================================

    match /announcements/{announcementId} {

      allow read: if true;

      allow create:
      if isAdmin() &&
         isValidId(announcementId) &&
         isValidAnnouncement(incoming());

      allow update:
      if isAdmin() &&
         isValidId(announcementId) &&
         isValidAnnouncement(incoming()) &&
         incoming().createdAt == existing().createdAt;

      allow delete:
      if isAdmin();
    }

    // ======================================================
    // DOCUMENTS
    // ======================================================

    match /documents/{documentId} {

      allow read: if true;

      allow create:
      if isAdmin() &&
         isValidId(documentId) &&
         isValidDocument(incoming());

      allow update:
      if isAdmin() &&
         isValidId(documentId) &&
         isValidDocument(incoming()) &&
         incoming().createdAt == existing().createdAt;

      allow delete:
      if isAdmin();
    }

    // ======================================================
    // APPLICATIONS
    // ======================================================

    match /applications/{appId} {

      allow read: if true;

      allow create:
      if isAdmin() &&
         isValidId(appId) &&
         isValidApplication(incoming());

      allow update:
      if isAdmin() &&
         isValidId(appId) &&
         isValidApplication(incoming()) &&
         incoming().createdAt == existing().createdAt;

      allow delete:
      if isAdmin();
    }

    // ======================================================
    // ADMIN CONFIG
    // ======================================================

    match /admin_config/main {

      allow read:
      if isAdmin();

      allow create, update:
      if isAdmin() &&
         isValidAdminConfig(incoming());
    }

    // ======================================================
    // SERVICE DETAILS
    // ======================================================

    match /service_details/{serviceId} {

      allow read: if true;

      allow create, update:
      if isAdmin() &&
         serviceId is string &&
         serviceId.size() <= 256;

      allow delete:
      if isAdmin();
    }

    // ======================================================
    // SKM SURVEYS
    // ======================================================

    match /skm_surveys/{surveyId} {

      allow read:
      if isAdmin();

      allow create:
      if true;

      allow update, delete:
      if isAdmin();
    }

    // ======================================================
    // STATS
    // ======================================================

    match /settings/stats {

      allow read: if true;

      allow create:
      if true &&
         incoming().visitCount == 1 &&
         incoming().keys().hasAll(['visitCount']);

      allow update:
      if true &&
         incoming()
           .diff(existing())
           .affectedKeys()
           .hasOnly(['visitCount', 'lastVisitAt']) &&

         incoming().visitCount is number;
    }
  }
}